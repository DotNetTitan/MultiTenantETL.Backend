{
  "name": "multitenant-etl-vue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "test": "vitest",
    "test:run": "vitest run",
    "test:all": "npm run test:services && npm run test:composables && npm run test:components",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:composables": "vitest --config vitest.config.composables.js --run src/composables/__tests__",
    "test:services": "vitest --config vitest.config.services.js --run src/services/__tests__",
    "test:stores": "vitest --config vitest.config.stores.js --run src/stores/__tests__",
    "test:components": "vitest --config vitest.config.components.js --run src/components/__tests__"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.6.7",
    "jwt-decode": "^4.0.0",
    "marked": "^17.0.0",
    "papaparse": "^5.4.1",
    "pinia": "^2.1.7",
    "prismjs": "^1.30.0",
    "vite": "^5.1.5",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0",
    "vuetify": "^3.5.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "jsdom": "^27.3.0",
    "msw": "^2.12.4",
    "sass": "^1.72.0",
    "vitest": "^4.0.16"
  }
}
