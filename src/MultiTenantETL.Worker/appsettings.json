{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MultiTenantETL;Username=postgres;Password=postgres"
  },
  "AppSettings": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Messaging": {
    "Provider": "RabbitMQ"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExecutionQueueName": "pipeline-executions",
    "CancellationQueueName": "pipeline-cancellations",
    "DeadLetterExchange": "pipeline-dlx",
    "PrefetchCount": 1,
    "MaxRetryAttempts": 5
  },
  "ServiceBus": {
    "ConnectionString": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE",
    "ExecutionQueueName": "pipeline-executions",
    "CancellationQueueName": "pipeline-cancellations",
    "PrefetchCount": 1,
    "MaxRetryAttempts": 5,
    "MaxConcurrentCalls": 1
  },
  "StorageQueue": {
    "ConnectionString": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE",
    "ExecutionQueueName": "pipeline-executions",
    "CancellationQueueName": "pipeline-cancellations",
    "MessageVisibilityTimeoutSeconds": 300,
    "MaxDequeueCount": 3,
    "MaxConcurrentReceives": 1,
    "PollingIntervalMs": 1000
  },
  "EtlSettings": {
    "DefaultBatchSize": 1000,
    "MaxBatchSize": 10000,
    "CommandTimeoutSeconds": 300,
    "StreamBufferSize": 81920,
    "MySqlBulkInsertChunkSize": 1000,
    "MaxRowsPerExecution": 0,
    "EnableDetailedLogging": false,
    "LogRetentionDays": 365
  },
  "EmailService": {
    "UseStub": false
  },
  "AzureCommunicationServices": {
    "ConnectionString": "REPLACE_WITH_USER_SECRET",
    "SenderEmailAddress": "REPLACE_WITH_USER_SECRET",
    "FrontendUrl": "http://localhost:5173"
  },
  "Encryption": {
    "_comment": "SECURITY: Set via user secrets (dev) or environment variable (prod). Generate with: openssl rand -base64 32",
    "Key": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE",
    "Salt": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE"
  },
  "AzureKeyVault": {
    "_comment": "Azure Key Vault settings for secure credential storage. VaultUri should be set via user secrets or environment variables.",
    "VaultUri": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE",
    "UseKeyVault": true,
    "SecretNamePrefix": "connector"
  },
  "Ssrf": {
    "_comment": "SSRF protection for outbound connector traffic. BlockPrivateNetworks=true blocks loopback, link-local (incl. 169.254.169.254 metadata), RFC1918 and CGNAT addresses. Self-hosted deployments reaching corporate networks should add CIDRs to AllowedPrivateCidrs.",
    "Enabled": true,
    "BlockPrivateNetworks": true,
    "AllowedPrivateCidrs": []
  }
}
