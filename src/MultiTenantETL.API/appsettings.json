{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "AppSettings": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Authentication": {
    "RequireEmailConfirmation": true,
    "EmailConfirmationTokenLifetimeHours": 24,
    "PasswordResetTokenLifetimeHours": 1
  },
  "Seeding": {
    "AdminPassword": "REPLACE_WITH_USER_SECRET",
    "OAuthClientSecret": "REPLACE_WITH_USER_SECRET"
  },
  "AzureCommunicationServices": {
    "ConnectionString": "REPLACE_WITH_USER_SECRET",
    "SenderEmailAddress": "REPLACE_WITH_USER_SECRET",
    "ApplicationName": "MultiTenantETL",
    "ApplicationUrl": "http://localhost:5173"
  },
  "EmailService": {
    "UseStub": false
  },
  "Encryption": {
    "_comment": "SECURITY: Set via user secrets (dev) or environment variable (prod). Generate with: openssl rand -base64 32",
    "Key": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE",
    "Salt": "REPLACE_WITH_USER_SECRET_OR_ENVIRONMENT_VARIABLE"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 31457280,
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "KeepAliveTimeoutSeconds": 120,
      "RequestHeadersTimeoutSeconds": 30
    }
  },
  "EtlSettings": {
    "DefaultBatchSize": 1000,
    "MaxBatchSize": 10000,
    "CommandTimeoutSeconds": 300,
    "StreamBufferSize": 81920,
    "MySqlBulkInsertChunkSize": 1000,
    "MaxRowsPerExecution": 0,
    "EnableDetailedLogging": false,
    "LogRetentionDays": 365
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExecutionQueueName": "pipeline-executions",
    "CancellationQueueName": "pipeline-cancellations",
    "DeadLetterExchange": "pipeline-dlx",
    "PrefetchCount": 1,
    "MaxRetryAttempts": 5
  }
}
